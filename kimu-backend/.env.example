# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=5000
NODE_ENV=development

# MongoDB
# Local example: mongodb://127.0.0.1:27017/kimu_transport
# Atlas example: mongodb+srv://<user>:<password>@cluster.mongodb.net/kimu_transport
MONGO_URI=mongodb://127.0.0.1:27017/kimu_transport

# Auth
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN=15m
JWT_ISSUER=kimu-api
JWT_AUDIENCE=kimu-client

# CORS - the URL your Vite frontend runs on
CLIENT_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
TRUST_PROXY_HOPS=0

# Private, persistent certificate files. Never expose this path as static content.
CERTIFICATE_STORAGE_DIR=./storage/certificates
PDF_QR_PAGE=1
PDF_QR_SIZE_MM=21.87
PDF_QR_MARGIN_MM=33.1
PDF_QR_CORNER=bottom-right
ALLOW_PUBLIC_PDF_WHEN_REVOKED=false
ALLOW_PUBLIC_DOWNLOAD=true

# One-time admin seed script (npm run seed:admin) - remove/rotate after first use
SEED_ADMIN_EMAIL=replace-with-admin-email
SEED_ADMIN_PASSWORD=replace-with-a-unique-strong-one-time-password
SEED_ADMIN_NAME=System Administrator
# Production only: set true for the single approved bootstrap run, then unset it.
SEED_ADMIN_ALLOW=false
