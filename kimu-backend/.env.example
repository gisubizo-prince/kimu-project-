# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=5000
NODE_ENV=development

# MongoDB
# Local example: mongodb://127.0.0.1:27017/kimu_transport
# Atlas example: mongodb+srv://<user>:<password>@cluster.mongodb.net/kimu_transport
MONGO_URI=mongodb://127.0.0.1:27017/kimu_transport

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS - the URL your Vite frontend runs on
CLIENT_URL=http://localhost:5173

# One-time admin seed script (npm run seed:admin) - remove/rotate after first use
SEED_ADMIN_EMAIL=admin@kimutransport.rw
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=System Administrator
