FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY . .
RUN mkdir -p /data/certificates && chown -R node:node /app /data/certificates && chmod 700 /data/certificates
USER node
EXPOSE 5000
CMD ["node", "server.js"]
